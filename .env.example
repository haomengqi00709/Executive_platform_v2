# =====================================================================
# CEO Platform v2 — environment variables
#
# Copy to .env and fill in values. Most production-critical vars are
# REQUIRED — the app fails fast at startup if any are missing.
# =====================================================================

# ── REQUIRED (no defaults; app will not start without these) ─────────

# Azure AD app registration — Web OAuth flow (used by deployed app).
# Both ID and secret come from Microsoft Entra ID portal:
#   App registrations → your app → Overview / Certificates & secrets
PROD_CLIENT_ID=
PROD_CLIENT_SECRET=

# Microsoft 365 tenant ID (the customer's tenant).
# Wrong value here = users see a sign-in page for the wrong organization.
TENANT_ID=

# Random secret used to sign JWT session cookies (NOT a Microsoft secret).
# Generate fresh: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=

# Google Gemini API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=

# ── Dual-provider architecture ───────────────────────────────────────────────
# Users pick their TEXT/chat model (Settings page → ai_provider: kimi | gemini). Search
# grounding, receipt vision and meeting transcription are capability-pinned to Gemini.
# Platform default when a user hasn't chosen (ships as gemini; flip to kimi after rollout):
AI_DEFAULT_PROVIDER=
# Kimi (Moonshot) — the OpenAI-compatible provider for the "kimi" choice.
# Key falls back to FALLBACK_API_KEY if unset (smooth migration from the bot-fallback era).
KIMI_API_KEY=
KIMI_MODEL=
# DeepSeek — the "deepseek" choice (cheapest: V4 Flash $0.14/$0.28 per 1M).
# Model defaults to deepseek-v4-flash; set deepseek-v4-pro for the stronger tier.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Legacy bot-fallback trio (OpenAI-compatible). Still honored as the bot's alternate engine
# when KIMI_API_KEY is not set. Any OpenAI-compatible provider works:
#   OpenAI:   FALLBACK_BASE_URL=https://api.openai.com/v1              FALLBACK_MODEL=gpt-4o-mini
#   DeepSeek: FALLBACK_BASE_URL=https://api.deepseek.com               FALLBACK_MODEL=deepseek-chat
#   Qwen(SG): FALLBACK_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  FALLBACK_MODEL=qwen-max
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_BASE_URL=

# ── DEPLOYMENT-SPECIFIC (must be set per environment) ────────────────

# Where per-user data lives.
#   Local dev   : .data  (default if unset)
#   Railway     : .data  (volume-mounted by Railway)
#   Azure       : /mnt/data  (Azure Files share mounted at /mnt/data)
DATA_DIR=

# OAuth callback URL — must exactly match a redirect URI registered
# in the Azure AD app, including https:// and exact host/path.
#   Local dev   : http://localhost:8000/auth/callback
#   Production  : https://your-app.example.com/auth/callback
REDIRECT_URI=

# Public app URL for the React frontend (no trailing slash).
# Used for CORS allowlist and as base for redirects after sign-in.
# Comma-separated for multiple origins (e.g. localhost + production).
FRONTEND_URL=

# Public base URL used in outbound emails / Teams links to the app.
# Defaults to FRONTEND_URL stripped of /auth/* when unset. Required
# for the auth-notifier (broken-sign-in email reconnect links).
APP_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────

# Device-flow client ID (used by local CLI / bot registration).
# Falls back to a dev default with a warning if unset — fine for local
# dev, but set explicitly in production for clean per-customer config.
CLIENT_ID=

# Azure App Service: tells the platform which container port to forward
# traffic to. The Dockerfile EXPOSE 8080, so this should be 8080 on Azure.
# Not used on Railway (Railway sets PORT directly).
WEBSITES_PORT=8080

# ── OPS / MONITORING (read by the standalone ops-dashboard) ──────────

# Shared secret guarding GET /api/admin/fleet-health. Must match the
# ops-dashboard's OPS_ADMIN_TOKEN. Unset → the endpoint returns 503.
OPS_ADMIN_TOKEN=

# Canary probe (stream 2): a user_id whose token→Graph path is exercised
# every 15 min as an end-to-end health check. Unset → probe is a no-op.
# A failing canary surfaces as a stalled `canary_probe` job in fleet-health.
CANARY_UID=

# Push-quality spot-check (stream 4): OFF by default because it makes
# Gemini judge/grounding calls (costs quota). Set to true to enable the
# hourly sampler. Optionally narrow the sections it scores (comma-separated;
# default: reply_needed,followup_needed,commitments_extract,ai_summary).
PUSH_QA_ENABLED=false
PUSH_QA_SECTIONS=
# Cost control: how many sections per user to deep-check with AI each run
# (rotating). Heuristics still run on ALL sections free; suspicious ones are
# always AI-checked regardless. Default 1. Set 0 to only AI-check flagged ones.
PUSH_QA_SAMPLE_PER_RUN=1
