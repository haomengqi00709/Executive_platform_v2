# =====================================================================
# CEO Platform v2 — environment variables
#
# Copy to .env and fill in values. Most production-critical vars are
# REQUIRED — the app fails fast at startup if any are missing.
# =====================================================================

# ── REQUIRED (no defaults; app will not start without these) ─────────

# Azure AD app registration — Web OAuth flow (used by deployed app).
# Both ID and secret come from Microsoft Entra ID portal:
#   App registrations → your app → Overview / Certificates & secrets
PROD_CLIENT_ID=
PROD_CLIENT_SECRET=

# Microsoft 365 tenant ID (the customer's tenant).
# Wrong value here = users see a sign-in page for the wrong organization.
TENANT_ID=

# Random secret used to sign JWT session cookies (NOT a Microsoft secret).
# Generate fresh: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET=

# Google Gemini API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=

# ── DEPLOYMENT-SPECIFIC (must be set per environment) ────────────────

# Where per-user data lives.
#   Local dev   : .data  (default if unset)
#   Railway     : .data  (volume-mounted by Railway)
#   Azure       : /mnt/data  (Azure Files share mounted at /mnt/data)
DATA_DIR=

# OAuth callback URL — must exactly match a redirect URI registered
# in the Azure AD app, including https:// and exact host/path.
#   Local dev   : http://localhost:8000/auth/callback
#   Production  : https://your-app.example.com/auth/callback
REDIRECT_URI=

# Public app URL for the React frontend (no trailing slash).
# Used for CORS allowlist and as base for redirects after sign-in.
# Comma-separated for multiple origins (e.g. localhost + production).
FRONTEND_URL=

# Public base URL used in outbound emails / Teams links to the app.
# Defaults to FRONTEND_URL stripped of /auth/* when unset. Required
# for the auth-notifier (broken-sign-in email reconnect links).
APP_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────

# Device-flow client ID (used by local CLI / bot registration).
# Falls back to a dev default with a warning if unset — fine for local
# dev, but set explicitly in production for clean per-customer config.
CLIENT_ID=

# Azure App Service: tells the platform which container port to forward
# traffic to. The Dockerfile EXPOSE 8080, so this should be 8080 on Azure.
# Not used on Railway (Railway sets PORT directly).
WEBSITES_PORT=8080
