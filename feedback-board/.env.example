# Shared password the internal team uses to open the board (any username).
TEAM_PASSWORD=change-me-team-password

# Admin credentials — needed to change request status / delete.
ADMIN_USER=jason
ADMIN_PASSWORD=change-me-admin-password

# Gemini (chat). Same key value as the main app is fine — separate quota only.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Secret shared with the GitHub repo webhook (Settings → Webhooks → Secret).
# Used to verify X-Hub-Signature-256 on POST /webhook/github.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Persisted state dir. Railway: /data with a mounted volume (else requests reset
# on every redeploy). Local: ./data
DATA_DIR=./data
