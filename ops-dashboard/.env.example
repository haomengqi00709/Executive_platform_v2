# Where the ops-dashboard pulls fleet-health from
MAIN_BACKEND_URL=https://executiveplatformv2-production.up.railway.app

# Shared secret with the main backend. Must match OPS_ADMIN_TOKEN there.
OPS_ADMIN_TOKEN=change-me-to-a-long-random-string

# Browser HTTP Basic Auth for the dashboard itself
OPS_ADMIN_USER=jason
OPS_ADMIN_PASSWORD=change-me

# Alert channels
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraccount@gmail.com
SMTP_PASS=app-password-not-real-password
SMTP_FROM=youraccount@gmail.com
SMTP_TO=youraccount@gmail.com

# Persisted state directory (Railway: /data with volume; Azure: /mnt/data/ops)
DATA_DIR=./data

# Polling interval (seconds). Default 60.
POLL_INTERVAL_SECS=60

# How often to re-alert if the same incident is still active (hours). Default 6.
ALERT_REPEAT_HOURS=6
